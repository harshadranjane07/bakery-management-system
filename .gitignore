# Node Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment Variables
.env
backend/.env

# Temporary & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Angular build artifacts (dist will be built by cloud host during deployment)
# Alternatively, keep dist if deploying pre-built
.angular/
frontend/.angular/

# Uploaded dynamic files (keep directory, ignore contents)
backend/uploads/*
!backend/uploads/.gitkeep

# OS generated files
.DS_Store
Thumbs.db
